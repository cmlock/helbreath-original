# --- Visual Studio / MSBuild build intermediates ---
# Note: some Release/ folders (Client/CxImage, Client/jpeg) already have
# their built .lib checked in as a vendored dependency. Ignoring the folder
# doesn't untrack those - .gitignore only hides untracked files, so the
# already-committed .lib keeps showing up as modified when it changes.
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.exe
*.dll
*.obj
*.ilk
*.pdb
*.idb
*.iobj
*.ipdb
*.exp
*.tlog/
*.log
*.lastbuildstate
*.recipe
*.vcxproj.FileListAbsolute.txt
*.vcxproj.user
*.sln.docstates
ipch/
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
.vs/

# --- Live server runtime state (generated by running Files/*Server.exe / HGserver.exe) ---
Files/Events.log
Files/GMLogData/
Files/GameServerLog/
Files/ItemLogData/
Files/Account/
Files/Character/
Files/GameServers/*/GameLogs/

# --- Windows / editor clutter ---
Thumbs.db
Desktop.ini
*~

Debug/
Release/

# --- Local tool runtime state (generated by running Tools/ utilities) ---
Tools/*.ini